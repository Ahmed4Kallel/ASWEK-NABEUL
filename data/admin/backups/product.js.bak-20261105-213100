/* ---------- Calculator modal ---------- */
function openCalculator() {
  let modal = document.getElementById('calcModal');
  if (!modal) {
    modal = document.createElement('div');
    modal.id = 'calcModal';
    modal.className = 'modal-backdrop';
    modal.innerHTML = `
      <div class="modal-dialog modal-lg">
        <div class="modal-header"><h5>Calculateur de résine</h5><button class="btn-close" data-close-calc>&times;</button></div>
        <div class="modal-body">
          <p class="fw-bold">1. Choisissez le type de coulée</p>
          <div class="d-flex flex-wrap" style="gap:10px;">
            ${['Rectangulaire','Circulaire','Forme irrégulière']
              .map((c, i) => `<button class="variation-box ${i === 0 ? 'active' : ''}" data-calc-type="${c}">${c}</button>`).join('')}
          </div>
          <p class="fw-bold mt-4">2. Entrez les dimensions</p>
          <div class="form-row-2">
            <div class="form-group calc-for-rect"><label>Longueur (cm)</label><input type="number" id="calcL" value="30" min="0"></div>
            <div class="form-group calc-for-rect"><label>Largeur (cm)</label><input type="number" id="calcW" value="20" min="0"></div>
            <div class="form-group calc-for-circle" style="display:none"><label>Diamètre (cm)</label><input type="number" id="calcD" value="20" min="0"></div>
            <div class="form-group calc-for-circle" style="display:none"><label>Poids d'eau équivalent (g)</label><input type="number" id="calcIR" value="0" min="0"></div>
            <div class="form-group"><label>Épaisseur (mm)</label><input type="number" id="calcT" value="10" min="0"></div>
          </div>
          <button class="btn-primary" id="calcCompute">Calculer</button>
          <div id="calcResult" class="mt-3" style="color:var(--green-dark)"></div>
          <p class="small ai-note mt-2">Estimation indicative (densité 1,1 g/cm³, +10 % de marge). Vérifiez toujours le ratio et la fiche technique du produit.</p>
          <hr>
          <h3>Questions fréquemment posées (FAQ)</h3>
          <details><summary>Comment calculer correctement la quantité de résine ?</summary><p class="small">Multipliez volume × densité selon le produit.</p></details>
          <details><summary>Quelle épaisseur est recommandée pour le revêtement ?</summary><p class="small">En général 1 à 3 mm pour un revêtement.</p></details>
          <details><summary>Que faire si la forme est irrégulière ?</summary><p class="small">Pesez un volume d'eau équivalent puis convertissez avec la densité de la résine.</p></details>
          <details><summary>Comment mélanger correctement les composants ?</summary><p class="small">Respectez le ratio A:B indiqué, mélangez lentement.</p></details>
          <p class="mt-3 mb-0"><a href="guides.html" style="color:var(--teal);font-weight:600">Voir tous les guides projet →</a></p>
        </div>
      </div>`;
    document.body.appendChild(modal);
    modal.addEventListener('click', e => { if (e.target === modal || e.target.hasAttribute('data-close-calc')) modal.classList.remove('show'); });
    modal.querySelectorAll('[data-calc-type]').forEach(b => b.addEventListener('click', () => {
      modal.querySelectorAll('[data-calc-type]').forEach(x => x.classList.remove('active'));
      b.classList.add('active');
      const type = b.dataset.calcType;
      modal.querySelectorAll('.calc-for-rect').forEach(el => el.style.display = type === 'Rectangulaire' ? '' : 'none');
      modal.querySelectorAll('.calc-for-circle').forEach(el => el.style.display = type === 'Rectangulaire' ? 'none' : '');
      const ir = modal.querySelector('#calcIR');
      if (ir) ir.closest('.form-group').style.display = type === 'Forme irrégulière' ? '' : 'none';
      const dEl = modal.querySelector('#calcD');
      if (dEl) dEl.closest('.form-group').style.display = type === 'Circulaire' ? '' : 'none';
    }));
    modal.querySelector('#calcCompute').addEventListener('click', () => {
      const type = (modal.querySelector('[data-calc-type].active') || {}).dataset?.calcType || 'Rectangulaire';
      const L = +modal.querySelector('#calcL').value, W = +modal.querySelector('#calcW').value;
      const T = +modal.querySelector('#calcT').value, D = +modal.querySelector('#calcD').value;
      const IR = +modal.querySelector('#calcIR').value;
      let vol;
      if (type === 'Circulaire') vol = Math.PI * Math.pow(D / 2, 2) * (T / 10) / 1000;
      else if (type === 'Forme irrégulière') vol = IR / 1.1 / 1000;
      else vol = L * W * (T / 10) / 1000;
      if (!isFinite(vol) || vol <= 0) {
        modal.querySelector('#calcResult').innerHTML = '<p class="text-danger">Veuillez saisir des dimensions valides.</p>';
        return;
      }
      const kg = vol * 1.1 * 1.1;
      modal.querySelector('#calcResult').innerHTML = `
        <div class="calc-result-card">
          <div><span class="small text-muted">Volume</span><div class="calc-result-val">${vol.toFixed(3)} L</div></div>
          <div><span class="small text-muted">Résine estimée (A+B)</span><div class="calc-result-val">${kg.toFixed(2)} kg</div></div>
        </div>`;
    });
  }
  modal.classList.add('show');
}

function setSEO() {
  const c = productContent;
  const ov = (typeof window.ASWEKOverrides !== 'undefined' && product) ? (window.ASWEKOverrides.get(product.slug).seo || {}) : {};

  // js/ai/product-ai.js est le propriétaire final des métadonnées SEO
  // (data/ai/seo-alt.json + surcharges admin). Ici on ne pose que des
  // valeurs de repli si ce module n'a pas encore écrit (fichier indisponible).
  const owned = !!window.__ASWEK_SEO_WRITTEN;
  const ensureMeta = (name, content) => {
    if (!content) return;
    let m = document.querySelector(`meta[name="${name}"]`);
    if (m) {
      if (!owned) m.setAttribute('content', content);
      return;
    }
    m = document.createElement('meta');
    m.setAttribute('name', name);
    document.head.appendChild(m);
    m.setAttribute('content', content);
  };

  const title = ov.seo_title || (c && c.seo_title) || (product.name + ' | ASWEK');
  if (!owned) document.title = title;
  ensureMeta('description', ov.seo_desc || (c && c.seo_description) || product.short || product.name);
  ensureMeta('keywords', (ov.keywords && ov.keywords.length) ? ov.keywords.join(', ') : ((c && c.keywords && c.keywords.join(', ')) || ''));

  const setOg = (prop, content) => {
    if (!content) return;
    let m = document.querySelector(`meta[property="${prop}"]`);
    if (!m) { m = document.createElement('meta'); m.setAttribute('property', prop); document.head.appendChild(m); }
    m.setAttribute('content', content);
  };
  setOg('og:title', document.title);
  const descMeta = document.querySelector('meta[name="description"]');
  setOg('og:description', (descMeta && descMeta.content) || product.name);
  setOg('og:image', product.img ? new URL(product.img, location.href).href : '');
  setOg('og:type', 'product');
}

document.addEventListener('DOMContentLoaded', () => {
  const slug = getQuery('p') || getQuery('slug') || getQuery('id');
  product = slug ? (PRODUCTS.find(p => p.slug === slug || String(p.id) === slug) || findProduct(slug)) : PRODUCTS[0];
  document.title = product.name + ' | ASWEK';
  renderBreadcrumb();
  renderProductTop();
  renderShort();
  renderTabs();
  renderRelated();
  observeFadeUps();

  loadProductContent().then(() => {
    setSEO();
    window.dispatchEvent(new Event('rp:content-ready'));
    if (!window.__ASWEK_SEO_WRITTEN && productContent && productContent.seo_title) document.title = productContent.seo_title;
  });
});
