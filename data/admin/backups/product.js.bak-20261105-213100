}

function renderAIDefinition() {
  const box = document.getElementById('aiDefinition');
  if (!box) return;

  const paint = () => {
    const c = productContent || fallbackContent();
    const def = c.definition || (product.short || '');
    const adv = (c.advantages && c.advantages.length)
      ? `<ul class="ai-advantages">${c.advantages.map(a => `<li><svg viewBox="0 0 24 24" width="16" height="16"><path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="3"/></svg><span>${a}</span></li>`).join('')}</ul>`
      : '';
    box.classList.remove('ai-loading');
    box.innerHTML = `
      <h3 class="ai-definition-title">Définition</h3>
      ${def ? `<p class="ai-definition-text">${def}</p>` : ''}
      ${adv}
      <p class="ai-note">${c.unavailable
        ? 'Contenu informatif généré automatiquement. Les informations techniques précises sont à vérifier auprès d\'ASWEK.'
        : 'Définition générée par intelligence artificielle à partir des données produit ASWEK. Les caractéristiques précises sont à vérifier sur la fiche technique.'}</p>`;
  };

  if (productContentReady) paint();
  else window.addEventListener('rp:content-ready', paint, { once: true });
}

