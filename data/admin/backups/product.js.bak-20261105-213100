    : '';

  el.innerHTML = `
    <div id="aiDefinition" class="ai-definition ai-loading">
      <div class="ai-skeleton"><span></span><span></span><span></span></div>
      <p class="ai-loading-text">Génération de la définition du produit…</p>
    </div>
    ${features}`;

