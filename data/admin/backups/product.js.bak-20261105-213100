function renderAITabs() {
  const paint = () => {
    const c = productContent || fallbackContent();

    const desc = document.getElementById('panelDesc');
    if (desc) {
      const paras = (c.description || '').split(/\n{2,}/).filter(Boolean)
        .map(x => `<p>${x}</p>`).join('');
      const feats = (c.features && c.features.length)
        ? `<h3>Caractéristiques</h3><ul class="ai-feature-list">${c.features.map(f => `<li><strong>${f.label} :</strong> ${f.value}</li>`).join('')}</ul>`
        : '';
      desc.innerHTML = `
        <h2>${product.name}</h2>
        ${paras || `<p>${c.definition}</p>`}
        ${feats}`;
    }

    const usage = document.getElementById('panelUsage');
    if (usage) {
      const u = (c.usage && c.usage.length) ? c.usage : [];
      usage.innerHTML = `
        <h2>Utilisations principales</h2>
        ${u.length ? `<ul class="ai-usage-list">${u.map(x => `<li>${x}</li>`).join('')}</ul>` : '<p>Les utilisations détaillées de ce produit seront précisées prochainement. Contactez ASWEK pour plus d\'informations.</p>'}
        ${c.howto ? `<h3>Mode d'emploi</h3><p>${c.howto}</p>` : ''}`;
    }

    const secu = document.getElementById('panelSecu');
    if (secu) {
      secu.innerHTML = `
        <h2>Information sur la sécurité</h2>
        <p>${c.safety || 'Consultez la fiche de données de sécurité (FDS) avant utilisation.'}</p>
        <p class="small ai-note">Ce contenu est fourni à titre informatif et ne remplace pas la fiche technique ou la FDS officielle du produit.</p>`;
    }
  };

  if (productContentReady) paint();
  else window.addEventListener('rp:content-ready', paint, { once: true });
}

