/* ResinPro clone - product detail page */

let product = null;
let activeVariation = 0;
let productContent = null;      // contenu généré par IA (data/product-content.json)
let productContentReady = false;

/* ------------------------------------------------------------------ */
/* Chargement du contenu IA (aucun appel réseau externe : fichier local) */
/* ------------------------------------------------------------------ */
function loadProductContent() {
  return fetch('data/product-content.json', { cache: 'force-cache' })
    .then(r => (r.ok ? r.json() : null))
    .catch(() => null)
    .then(json => {
      if (json && json.products && product) {
        productContent = json.products[product.slug] || null;
      }
      return productContent;
    })
    .then(() => (typeof window.ASWEKOverrides !== 'undefined' && window.ASWEKOverrides.ready)
      ? window.ASWEKOverrides.ready
      : Promise.resolve(null))
    .then(() => {
      // seule une description explicitement validée par l'administrateur remplace le texte IA
      const d = (typeof window.ASWEKOverrides !== 'undefined' && product)
        ? window.ASWEKOverrides.approvedDescription(product.slug)
        : null;
      if (d && d.definition) {
        productContent = Object.assign({}, productContent || {}, {
          definition: d.definition,
          advantages: (d.advantages && d.advantages.length) ? d.advantages : (productContent ? productContent.advantages : [])
        });
      }
      productContentReady = true;
      return productContent;
    });
}

/* Contenu de secours si l'IA/fichier indisponible : on n'invente rien. */
function fallbackContent() {
  return {
    definition: product.short || `${product.name} — produit de la gamme ASWEK.`,
    description: product.short || 'La description détaillée de ce produit est en cours de rédaction. Revenez bientôt pour plus d\'informations.',
    usage: [],
    features: [],
    advantages: [],
    howto: '',
    safety: 'Pour toute information de sécurité, veuillez consulter la fiche de données de sécurité (FDS) du produit.',
    unavailable: true
  };
}

function renderBreadcrumb() {
  const c = document.getElementById('breadcrumb');
  const cat = (product.cat || []).find(x => x !== 'aswek' && !x.startsWith('aswek-')) || 'les-resines';
  c.innerHTML = `<a href="index.html">Accueil</a><span class="sep">/</span>
    <a href="shop.html">Boutique</a><span class="sep">/</span>
    <a href="category.html?c=${cat}">${prettyCat(cat)}</a><span class="sep">/</span>
    <span class="current">${product.name}</span>`;
}

function isEpoxyResinProduct(p) {
  const cats = p && p.cat ? p.cat : [];
  if (cats.includes('resines-epoxy')) return true;
  const name = (p && p.name ? p.name : '').toLowerCase();
  if (name.includes('resine epoxy') || name.includes('résine epoxy')) return true;
  return false;
}

